{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Go WASM (Breakout)",
            "type": "shell",
            "command": "${workspaceFolder}/build_wasm.bat",
            "windows": {
                "command": "${workspaceFolder}/build_wasm.bat"
            },
            "linux": {
                "command": "bash",
                "args": ["${workspaceFolder}/build_wasm.sh"]
            },
            "osx": {
                "command": "bash",
                "args": ["${workspaceFolder}/build_wasm.sh"]
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        }
    ]
}
